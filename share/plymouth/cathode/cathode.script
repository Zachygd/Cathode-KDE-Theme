# Cathode boot animation (Plymouth script theme)
# Black screen, the animated Cathode logo, and a thin progress bar at the bottom.
# Also handles the disk-encryption password prompt and boot messages.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

# ---- animated logo -----------------------------------------------------------
NFRAMES = 16;
first = Image("frame-1.png");
logo_h = Math.Int(screen_h * 0.30);
logo_w = Math.Int(first.GetWidth() * logo_h / first.GetHeight());
for (i = 0; i < NFRAMES; i++) {
    frames[i] = Image("frame-" + (i + 1) + ".png").Scale(logo_w, logo_h);
}
logo = Sprite(frames[0]);
logo.SetX(Math.Int((screen_w - logo_w) / 2));
logo.SetY(Math.Int((screen_h - logo_h) / 2 - screen_h * 0.05));
logo.SetZ(10);

global.tick = 0;
fun refresh_callback() {
    global.tick = global.tick + 1;
    # ~12 fps at Plymouth's 50 Hz refresh
    global.logo.SetImage(global.frames[Math.Int(global.tick / 4) % global.NFRAMES]);
}
Plymouth.SetRefreshFunction(refresh_callback);

# ---- progress bar ------------------------------------------------------------
bar_src = Image("bar.png");
bar_h = Math.Max(3, Math.Int(screen_h * 0.006));
bar = Sprite();
bar.SetX(0);
bar.SetY(screen_h - bar_h);
bar.SetZ(20);

fun progress_callback(duration, progress) {
    w = Math.Int(global.screen_w * progress);
    if (w > 0) {
        global.bar.SetImage(global.bar_src.Scale(w, global.bar_h));
    }
}
Plymouth.SetBootProgressFunction(progress_callback);

# ---- password prompt (encrypted disks) -----------------------------------------
prompt = Sprite();
bullets = Sprite();
prompt.SetZ(30);
bullets.SetZ(30);

fun display_normal_callback() {
    global.prompt.SetOpacity(0);
    global.bullets.SetOpacity(0);
}

fun display_password_callback(text, count) {
    if (text == "") text = "Password:";
    p = Image.Text(text, 1, 1, 1);
    global.prompt.SetImage(p);
    global.prompt.SetX(Math.Int((global.screen_w - p.GetWidth()) / 2));
    global.prompt.SetY(Math.Int(global.screen_h * 0.75));
    global.prompt.SetOpacity(1);
    s = "";
    for (i = 0; i < count; i++) s = s + "*";
    if (s == "") s = " ";
    b = Image.Text(s, 1, 1, 1);
    global.bullets.SetImage(b);
    global.bullets.SetX(Math.Int((global.screen_w - b.GetWidth()) / 2));
    global.bullets.SetY(Math.Int(global.screen_h * 0.75) + p.GetHeight() + 8);
    global.bullets.SetOpacity(1);
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

# ---- boot messages -----------------------------------------------------------
message = Sprite();
message.SetZ(30);
fun message_callback(text) {
    m = Image.Text(text, 0.6, 0.6, 0.6);
    global.message.SetImage(m);
    global.message.SetX(Math.Int((global.screen_w - m.GetWidth()) / 2));
    global.message.SetY(global.screen_h - global.bar_h - m.GetHeight() - 12);
}
Plymouth.SetMessageFunction(message_callback);
